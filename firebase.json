{
  "hosting": {
    "site": "practice-b23d7",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/view-bill",
        "destination": "/view-bill.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/create-bill",
        "destination": "/create-bill.html"
      },
      {
        "source": "/settings",
        "destination": "/settings.html"
      },
      {
        "source": "/register",
        "destination": "/register.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/users",
        "destination": "/users.html"
      },
      {
        "source": "/user-approvals",
        "destination": "/users.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}